{
  "$description": "Red Marten design tokens v1.0 — W3C DTCG format. Source of truth for tokens.css, tailwind.preset.ts and design-tool sync.",

  "brand": {
    "$description": "Theme-invariant. The logo plate must not shift between light and dark.",
    "red":   { "$type": "color", "$value": "#8A0E0D", "$description": "sampled from the supplied logo plate" },
    "cream": { "$type": "color", "$value": "#EFE6DF", "$description": "sampled from the supplied mark" }
  },

  "color": {
    "red": {
      "950": { "$type": "color", "$value": "#4A0908" },
      "900": { "$type": "color", "$value": "#5F0C0A" },
      "800": { "$type": "color", "$value": "#74100E", "$description": "primary button hover" },
      "700": { "$type": "color", "$value": "#8A0E0D", "$description": "core — accent, plates, chart series 1" },
      "600": { "$type": "color", "$value": "#A31C18", "$description": "dark-theme primary button" },
      "500": { "$type": "color", "$value": "#BC3630" },
      "400": { "$type": "color", "$value": "#CF5F52", "$description": "dark-theme accent — #8A0E0D is 1.9:1 on dark" },
      "200": { "$type": "color", "$value": "#EFC4BE" },
      "100": { "$type": "color", "$value": "#F8E7E3" }
    },
    "bone": {
      "0":   { "$type": "color", "$value": "#FFFFFF", "$description": "card surface, light theme only" },
      "50":  { "$type": "color", "$value": "#FCF8F5", "$description": "app canvas" },
      "100": { "$type": "color", "$value": "#F5EDE8", "$description": "alt surface, row hover" },
      "150": { "$type": "color", "$value": "#EFE6DF", "$description": "the logo cream — fixed by the identity, not chosen" },
      "200": { "$type": "color", "$value": "#E5D9D2", "$description": "default hairline border" },
      "300": { "$type": "color", "$value": "#CFC1B9", "$description": "input + node border" },
      "400": { "$type": "color", "$value": "#9E908A", "$description": "labels, placeholders — 2.9:1, decorative only" },
      "600": { "$type": "color", "$value": "#6C625D", "$description": "secondary text" },
      "800": { "$type": "color", "$value": "#3A3330" },
      "900": { "$type": "color", "$value": "#1A1614", "$description": "primary text" },
      "950": { "$type": "color", "$value": "#0D0A09" }
    },
    "patina": { "$type": "color", "$value": "#5F6B5E", "$description": "chart series 2 only — never an interactive state" },
    "semantic": {
      "success": { "$type": "color", "$value": "#4E7A5B", "$description": "sage, pushed green to sit clear of the brand red" },
      "warning": { "$type": "color", "$value": "#8F6D2E", "$description": "dark ochre, never orange" },
      "danger":  { "$type": "color", "$value": "#B23A2C", "$description": "TEXT AND ICONS ONLY — see the two-reds rule" },
      "info":    { "$type": "color", "$value": "#4E6373", "$description": "slate, never bright blue" }
    },
    "chart": {
      "1": { "$type": "color", "$value": "#8A0E0D" },
      "2": { "$type": "color", "$value": "#5F6B5E" },
      "3": { "$type": "color", "$value": "#CFC1B9" },
      "4": { "$type": "color", "$value": "#6C625D" },
      "5": { "$type": "color", "$value": "#9E908A" },
      "6": { "$type": "color", "$value": "#3A3330" },
      "other": { "$type": "color", "$value": "#E5D9D2" }
    },
    "role": {
      "light": {
        "bg":           { "$value": "{color.bone.50}" },
        "bgAlt":        { "$value": "{color.bone.100}" },
        "surface":      { "$value": "{color.bone.0}" },
        "surface2":     { "$value": "{color.bone.100}" },
        "surfaceSunk":  { "$value": "{color.bone.150}" },
        "border":       { "$value": "{color.bone.200}" },
        "borderStrong": { "$value": "{color.bone.300}" },
        "fg":           { "$value": "{color.bone.900}" },
        "fg2":          { "$value": "{color.bone.600}" },
        "fg3":          { "$value": "{color.bone.400}" },
        "fgInverse":    { "$value": "{color.bone.50}" },
        "accent":       { "$value": "{color.red.700}" },
        "accentSoft":   { "$value": "rgb(138 14 13 / .08)" },
        "glass":        { "$value": "rgb(252 248 245 / .72)" }
      },
      "dark": {
        "bg":           { "$value": "#111010" },
        "bgAlt":        { "$value": "#171514" },
        "surface":      { "$value": "#1C1A18" },
        "surface2":     { "$value": "#232120" },
        "surfaceSunk":  { "$value": "#0C0A09" },
        "border":       { "$value": "#2E2A27" },
        "borderStrong": { "$value": "#3D3835" },
        "fg":           { "$value": "#F2E9E3" },
        "fg2":          { "$value": "#B3A8A2" },
        "fg3":          { "$value": "#857A75" },
        "fgInverse":    { "$value": "#150F0E" },
        "accent":       { "$value": "{color.red.400}" },
        "accentSoft":   { "$value": "rgb(207 95 82 / .13)" },
        "glass":        { "$value": "rgb(23 21 20 / .72)" }
      }
    },
    "$rules": {
      "twoReds": "The brand red and the error red share a hue family, so they are separated by ROLE. Marten Red is a SURFACE — plates, primary buttons, active nav, focus rings, chart series 1. Error red #B23A2C is TEXT AND ICONOGRAPHY — never a fill larger than a badge. For an error surface use danger-soft at 11% with the border, never the solid.",
      "darkMode": "Not an inversion. #8A0E0D is 1.9:1 on #111010; dark mode substitutes red.400 for every accent role and lifts all four semantics one step. The logo plate keeps #8A0E0D in both themes — it is a brand surface, not a UI token."
    }
  },

  "font": {
    "display": { "$type": "fontFamily", "$value": ["Familjen Grotesk", "Neue Montreal", "sans-serif"] },
    "sans":    { "$type": "fontFamily", "$value": ["Geist", "Satoshi", "sans-serif"] },
    "mono":    { "$type": "fontFamily", "$value": ["Geist Mono", "JetBrains Mono", "monospace"] }
  },

  "text": {
    "display": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "60px", "lineHeight": "61px", "letterSpacing": "-0.035em", "fontWeight": 600 } },
    "h1":      { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "40px", "lineHeight": "44px", "letterSpacing": "-0.03em",  "fontWeight": 600 } },
    "h2":      { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "30px", "lineHeight": "35px", "letterSpacing": "-0.025em", "fontWeight": 600 } },
    "title":   { "$type": "typography", "$value": { "fontFamily": "{font.sans}",    "fontSize": "20px", "lineHeight": "26px", "letterSpacing": "-0.015em", "fontWeight": 600 } },
    "subtitle":{ "$type": "typography", "$value": { "fontFamily": "{font.sans}",    "fontSize": "17px", "lineHeight": "25px", "letterSpacing": "0",        "fontWeight": 400 } },
    "body":    { "$type": "typography", "$value": { "fontFamily": "{font.sans}",    "fontSize": "15px", "lineHeight": "24px", "letterSpacing": "0",        "fontWeight": 400 } },
    "small":   { "$type": "typography", "$value": { "fontFamily": "{font.sans}",    "fontSize": "13px", "lineHeight": "20px", "letterSpacing": "0",        "fontWeight": 400 } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{font.sans}",    "fontSize": "12px", "lineHeight": "17px", "letterSpacing": "0",        "fontWeight": 400 } },
    "label":   { "$type": "typography", "$value": { "fontFamily": "{font.mono}",    "fontSize": "11px", "lineHeight": "14px", "letterSpacing": "0.12em",   "fontWeight": 500, "textTransform": "uppercase" } },
    "button":  { "$type": "typography", "$value": { "fontFamily": "{font.sans}",    "fontSize": "14px", "lineHeight": "14px", "letterSpacing": "-0.005em", "fontWeight": 500 } },
    "numeric": { "$type": "typography", "$value": { "fontFamily": "{font.mono}",    "fontSize": "26px", "lineHeight": "30px", "letterSpacing": "-0.02em",  "fontWeight": 500, "fontVariantNumeric": "tabular-nums" } }
  },

  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "96px" },
    "10": { "$type": "dimension", "$value": "128px" }
  },

  "radius": {
    "xs":   { "$type": "dimension", "$value": "4px",   "$description": "checkbox, tag, sparkline mask" },
    "sm":   { "$type": "dimension", "$value": "6px",   "$description": "small button, chip, icon tile" },
    "md":   { "$type": "dimension", "$value": "10px",  "$description": "button, input, select" },
    "lg":   { "$type": "dimension", "$value": "14px",  "$description": "card, panel, node, table" },
    "xl":   { "$type": "dimension", "$value": "20px",  "$description": "modal, drawer, feature tile" },
    "2xl":  { "$type": "dimension", "$value": "28px",  "$description": "hero media, app icon, logo plate" },
    "full": { "$type": "dimension", "$value": "999px", "$description": "badge, avatar, pill, meter" }
  },

  "shadow": {
    "1": { "$type": "shadow", "$value": "0 1px 2px rgb(26 22 20 / .05)" },
    "2": { "$type": "shadow", "$value": "0 2px 6px -1px rgb(26 22 20 / .07), 0 1px 2px rgb(26 22 20 / .05)" },
    "3": { "$type": "shadow", "$value": "0 12px 28px -8px rgb(26 22 20 / .14), 0 2px 6px rgb(26 22 20 / .05)" },
    "4": { "$type": "shadow", "$value": "0 32px 64px -20px rgb(26 22 20 / .22), 0 4px 12px rgb(26 22 20 / .06)" }
  },

  "ease": {
    "out":    { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] },
    "inout":  { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] },
    "spring": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1] }
  },

  "duration": {
    "fast": { "$type": "duration", "$value": "140ms" },
    "base": { "$type": "duration", "$value": "240ms" },
    "slow": { "$type": "duration", "$value": "420ms" },
    "cine": { "$type": "duration", "$value": "860ms" }
  },

  "motion": {
    "mark": {
      "leap":   { "$value": { "duration": 860,  "wipe": 640, "bodyDelay": 200, "ease": "spring", "loop": false, "meaning": "Red Marten is arriving",   "surfaces": ["splash", "landing-hero", "login", "welcome"] } },
      "trail":  { "$value": { "duration": 1200, "ease": "inout", "loop": true,  "meaning": "The system is fetching",  "surfaces": ["dashboard-boot", "route-change", "query", "skeleton"] } },
      "scent":  { "$value": { "duration": 1800, "ease": "inout", "loop": true,  "meaning": "An agent is reasoning",   "surfaces": ["chat-thinking", "brand-intelligence", "ai-summary"] } },
      "sprint": { "$value": { "duration": 1600, "ease": "inout", "loop": true,  "meaning": "A workflow is executing", "surfaces": ["canvas-run", "campaign-dispatch", "voice-queue"] } }
    }
  },

  "layout": {
    "max":             { "$type": "dimension", "$value": "1440px" },
    "gutter":          { "$type": "dimension", "$value": "32px" },
    "sidebarWidth":    { "$type": "dimension", "$value": "264px" },
    "sidebarCollapsed":{ "$type": "dimension", "$value": "64px" },
    "topbarHeight":    { "$type": "dimension", "$value": "56px" },
    "nodeWidth":       { "$type": "dimension", "$value": "224px" },
    "canvasDot":       { "$type": "dimension", "$value": "18px" },
    "measure":         { "$value": "68ch" }
  },

  "logo": {
    "$description": "Vectored from test.png (199x192) at 96.06% pixel overlap. Two closed paths plus one counter. Geometry is descriptive — the mark is path data, not a construction. See brand book §02.",
    "grid":        { "$value": 120, "$description": "viewBox 0 0 120 120, mark bbox centred on 60,60" },
    "markWidth":   { "$value": 112.0 },
    "markHeight":  { "$value": 103.4 },
    "shapes":      { "$value": ["body", "tail"], "$description": "plus the eye as an evenodd counter inside body" },
    "curveCount":  { "$value": { "body": 28, "tail": 11, "eye": 2, "total": 41 } },
    "leapAxis":    { "$value": 43, "$description": "degrees, lower-left to upper-right" },
    "areaRatio":   { "$value": { "body": 75, "tail": 25 }, "$description": "never re-weight" },
    "bodyTrailGap":{ "$value": 1.9, "$description": "narrowest point, below the haunch" },
    "eye":         { "$value": { "width": 3.7, "height": 2.0, "centre": [98.9, 30.1] } },
    "fillRule":    { "$value": "evenodd" },
    "mirror":      { "$value": false, "$description": "the marten always leaps right" },
    "eyeMinSize":  { "$value": "32px", "$description": "below this the counter fills in — drop it" },
    "maxScale":    { "$value": 1.04, "$description": "beyond this the 1.9 u body-trail gap closes" },
    "clearSpace":  { "$value": "0.25 x mark width" },
    "minSize":     { "$value": { "iconDigital": "16px", "iconPrint": "8mm", "lockupDigital": "128px", "lockupPrint": "32mm" } }
  }
}
